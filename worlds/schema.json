{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fle-virtual-worlds/world.schema.json",
  "title": "FLE Virtual World manifest",
  "description": "Describes one world: what it is (for the portal and for people), and, for skyship worlds, how the shared engine builds it. Rendering code stays in the module; everything else lives here. See docs/WORLD_FORMAT.md.",
  "type": "object",
  "required": ["id", "kind", "name", "summary", "categories", "time", "place", "purposes", "launch", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unique id; also the file name (worlds/<id>.json)." },
    "kind": { "enum": ["world", "experience", "film", "film-world"], "description": "world = runs on the shared skyship engine; experience = a standalone app; film / film-world = viewed through the film studio." },
    "name": { "type": "string" },
    "summary": { "type": "string", "description": "One sentence for the portal card." },
    "description": { "type": "string" },
    "categories": { "type": "array", "minItems": 1, "items": { "enum": ["sustainability", "technology", "space"] }, "description": "Portal colour: sustainability = green, technology = red, space = purple. A world can have several." },
    "themes": { "type": "array", "items": { "type": "string" } },
    "time": { "type": "object", "required": ["era", "label"], "properties": {
      "era": { "enum": ["past", "present", "future", "past-to-future"] }, "label": { "type": "string" }, "year": { "type": "integer" } } },
    "place": { "type": "object", "required": ["type", "name"], "properties": {
      "type": { "enum": ["city", "laboratory", "orbit", "spacecraft", "planet", "virtual"] }, "name": { "type": "string" }, "fictional": { "type": "boolean" },
      "geo": { "type": "object", "properties": { "lat": { "type": "number" }, "lon": { "type": "number" }, "note": { "type": "string" } } } } },
    "purposes": { "type": "array", "items": { "enum": ["explore", "learn", "simulate", "design", "experience a story"] } },
    "learningObjectives": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "object", "required": ["stage"], "properties": { "stage": { "enum": ["planned", "draft", "pilot", "complete", "film-only"] }, "notes": { "type": "string" } } },
    "disclaimer": { "type": "string", "description": "Shown in the engine while the world is on screen (e.g. 'artistic scenario, not an official plan')." },
    "launch": { "type": "array", "items": { "type": "object", "required": ["label", "href"], "properties": { "label": { "type": "string" }, "href": { "type": "string", "description": "Relative to the repository root." }, "mode": { "enum": ["cinematic", "explore", "learn"] } } } },
    "preview": { "type": "string", "description": "Card image, relative to the repository root (portal/img/<id>.jpg; generate with tools/qa/make_previews.py)." },
    "project": { "type": "string", "description": "Folder of the app that runs this world, for worlds not on the shared engine." },
    "engine": { "type": "object", "description": "For kind=world: how the skyship engine builds it.", "properties": {
      "type": { "enum": ["skyship", "raymarch-glsl"] },
      "module": { "type": "string", "description": "ES module path from the repository root." },
      "build": { "type": "string", "description": "Exported function: build(ctx) → { group, path, update(t), anchors, telescope, colliders?, blockRoof? }." },
      "chapter": { "type": "integer" },
      "space": { "type": "boolean", "description": "Status panel shows orbit altitude/speed." },
      "earth": { "type": "boolean", "description": "Show the engine's Earth and Moon." },
      "cabinLight": { "type": "number" },
      "entry": { "type": "object", "description": "Entry camera: world-local time, camera, position, heading." },
      "display": { "type": "object", "description": "Text for the cabin screens and title hologram.", "required": ["chip", "year", "title", "author", "sub", "theme", "themeLine", "place", "below"] },
      "atmosphere": { "type": "object", "description": "Lighting and atmosphere: sky gradient (top/hor/bot), fog colour/density, sun direction/colour/strength, ambient, stars, cloud band and amount, exposure, and the whiteout colour used when entering this world.",
        "required": ["top", "hor", "bot", "fog", "fogD", "sun", "sunCol", "sS", "aS", "hemiS", "hemiG", "stars", "cloud", "cloudAmt", "band", "cloudy", "exp", "moonDisk"] } } },
    "navigation": { "type": "object", "properties": { "modes": { "type": "array", "items": { "enum": ["cinematic", "explore", "learn"] } }, "controls": { "type": "array", "items": { "type": "string" } } } },
    "stops": { "type": "array", "description": "Where the ship hovers in Explore/Learn modes. t is world-local time.", "items": { "type": "object", "required": ["t", "name"], "properties": { "t": { "type": "number" }, "name": { "type": "string" }, "hotspots": { "type": "array", "items": { "type": "string" } }, "lead": { "type": "number" } } } },
    "hotspots": { "type": "array", "items": { "$ref": "#/$defs/hotspot" } },
    "facts": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "source": { "type": "string" } } } },
    "assets": { "type": "object", "description": "Referenced models, textures, shared code and data sets." },
    "lighting": { "type": "string" },
    "audio": { "type": "object", "properties": { "score": { "type": "object", "description": "Settings for skyship-engine/js/score.js: chords (MIDI arrays), bar, bells, pulse, ambience (city|space|none), drone, bright." }, "track": { "type": "string" } } },
    "portals": { "type": "array", "items": { "type": "object", "required": ["to"], "properties": { "to": { "type": "string" }, "via": { "type": "string", "description": "Journey id that makes the connection." }, "label": { "type": "string" } } } },
    "formats": { "type": "object", "properties": { "desktop": { "type": "boolean" }, "mobile": { "type": "boolean" }, "webxr": { "type": "boolean" }, "video360": { "type": "boolean" }, "video16x9": { "type": "boolean" } } },
    "gis": { "type": "object", "properties": { "ready": { "type": "boolean" }, "notes": { "type": "string" } } }
  },
  "$defs": {
    "hotspot": { "type": "object", "required": ["id", "anchor", "title", "category", "text"], "properties": {
      "id": { "type": "string", "description": "Unique within a journey." },
      "anchor": { "type": "string", "description": "Name of a point in the module's anchors." },
      "label": { "type": "string", "description": "Short marker text." },
      "category": { "enum": ["sustainability", "technology", "space"] },
      "kicker": { "type": "string" }, "title": { "type": "string" }, "text": { "type": "string" },
      "facts": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" }, "source": { "type": "string" } } } },
      "archive": { "type": "string", "description": "What ARCHIVE says when you open it." },
      "size": { "type": "number", "description": "Telescope framing, metres." }, "range": { "type": "number", "description": "Marker visible within this distance (default 2600 m)." },
      "mood": { "type": "string" },
      "question": { "type": "object", "required": ["q", "options", "answer"], "properties": { "q": { "type": "string" }, "options": { "type": "array", "items": { "type": "string" } }, "answer": { "type": "integer" }, "why": { "type": "string" } } } } }
  }
}
